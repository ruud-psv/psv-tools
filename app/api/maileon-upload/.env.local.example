# Maileon Media Library Upload
# Kopieer dit bestand naar .env.local in de root van het project en vul de waarden in.

# Base URL van jouw Maileon instantie (zonder trailing slash)
MAILEON_BASE_URL=https://psv-news-mailer.maileon.com/eagle_kp_webapp/content/medialib

# Maileon API-key (te vinden in Maileon onder Account → API Keys)
MAILEON_API_KEY=plak_hier_je_api_key

# Folder ID in de mediabibliotheek (standaard uploadfolder)
MAILEON_FOLDER_ID=n9267_2
